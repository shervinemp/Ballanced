@@ -3198,8 +3205,20 @@ void RCKRenderContext::UpdateProjection(CKBOOL forceUpdate) {
 
     const float aspect = (float) ((double) m_ViewportData.ViewWidth / (double) m_ViewportData.ViewHeight);
 
+#if defined(GEKKO)
+    // On a 16:9 set the TV stretches the frame buffer by the pixel aspect:
+    // widen the horizontal field of view as much and keep the vertical one,
+    // so the picture keeps its proportions and shows more at the sides.
+    // Textures rendered to keep square pixels.
+    const float stretch = m_TargetTexture ? 1.0f : VxWiiGetPixelAspect();
+    const float fov = 2.0f * atanf(tanf(m_Fov * 0.5f) * stretch);
+    const float perspectiveAspect = aspect * stretch;
+#else
+    const float fov = m_Fov;
+    const float perspectiveAspect = aspect;
+#endif
     if (m_Perspective)
-        m_ProjectionMatrix.Perspective(m_Fov, aspect, m_NearPlane, m_FarPlane);
+        m_ProjectionMatrix.Perspective(fov, perspectiveAspect, m_NearPlane, m_FarPlane);
     else
         m_ProjectionMatrix.Orthographic(m_Zoom, aspect, m_NearPlane, m_FarPlane);
 
