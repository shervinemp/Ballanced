+// The index range checks of CheckHWVertexBuffer and CheckHWIndexBuffer read
+// every index of every mesh drawn, each frame: a quarter of the Wii's drawing
+// time. A mesh whose index arrays, vertex counts and base vertices are as they
+// were when the checks last passed is not checked again. The GX rasterizer
+// clamps indices itself, so a change the key misses could misdraw a mesh but
+// not read outside its vertex buffer.
+static XHashTable<CKDWORD, RCKMesh *> g_FitCheckedMeshes;
+static XHashTable<CKDWORD, RCKMesh *> g_RangeCheckedMeshes;
+
+// A fingerprint of the index arrays: where they are, their lengths and a few
+// of their values, with the vertex counts and base vertices they index.
+static CKDWORD CKMeshIndexLayoutKey(const XArray<CKMaterialGroup *> &groups, CKDWORD vertexCount,
+                                    CKDWORD bufferVertexCount) {
+    CKDWORD key = 2166136261u;
+    auto mix = [&key](CKDWORD value) { key = (key ^ value) * 16777619u; };
+    mix(vertexCount);
+    mix(bufferVertexCount);
+    mix((CKDWORD)groups.Size());
+    for (int i = 0; i < groups.Size(); ++i) {
+        const CKMaterialGroup *group = groups[i];
+        if (!IsRenderableMaterialGroup(group)) {
+            mix(0);
+            continue;
+        }
+        mix((CKDWORD)(CKUINTPTR)group);
+        mix(group->m_BaseVertex);
+        mix(group->m_VertexCount);
+        mix(group->m_RemapData ? 1u : 0u);
+        mix((CKDWORD)group->m_Primitives.Size());
+        for (int p = 0; p < group->m_Primitives.Size(); ++p) {
+            const XArray<CKWORD> &indices = group->m_Primitives[p].m_Indices;
+            const int count = indices.Size();
+            mix((CKDWORD)(CKUINTPTR)indices.Begin());
+            mix((CKDWORD)count);
+            if (count > 0)
+                mix((CKDWORD)indices[0] | ((CKDWORD)indices[count / 2] << 16) ^ ((CKDWORD)indices[count - 1] << 8));
+        }
+    }
+    return key;
+}
+
+static CKBOOL CKMeshLayoutChecked(XHashTable<CKDWORD, RCKMesh *> &checked, RCKMesh *mesh, CKDWORD key) {
+    CKDWORD value = 0;
+    return checked.LookUp(mesh, value) && value == key;
+}
