+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+// Controller keys are dumped into chunks as raw words, which keep the
+// little-endian file layout: convert a dump between that layout and the host.
+// Keys are 32-bit values except the compressed normals of morph keys, which
+// are pairs of 16-bit angles.
+static void ConvertControllerKeys(CKDWORD type, void *keys, int wordCount, bool toHost) {
+    CKDWORD *words = static_cast<CKDWORD *>(keys);
+    if (type != CKANIMATION_MORPH_CONTROL) {
+        CKConvertEndianArray32(words, wordCount);
+        return;
+    }
+    if (wordCount < 3)
+        return;
+    if (toHost)
+        CKConvertEndianArray32(words, 3);
+    const int keyCount = (int) words[0];
+    const int vertexCount = (int) words[1];
+    const bool normals = words[2] != 0;
+    if (!toHost)
+        CKConvertEndianArray32(words, 3);
+    int pos = 3;
+    for (int i = 0; i < keyCount && vertexCount >= 0; ++i) {
+        const int positionWords = 1 + 3 * vertexCount;
+        if (pos + positionWords > wordCount)
+            return;
+        CKConvertEndianArray32(&words[pos], positionWords);
+        pos += positionWords;
+        if (normals) {
+            if (pos + vertexCount > wordCount)
+                return;
+            CKConvertEndianArray16(&words[pos], 2 * vertexCount);
+            pos += vertexCount;
+        }
+    }
+}
+#else
+static void ConvertControllerKeys(CKDWORD, void *, int, bool) {}
+#endif
