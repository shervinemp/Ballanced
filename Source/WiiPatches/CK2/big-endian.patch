+// One word of chunk data. Chunks keep the little-endian layout of Virtools
+// files in memory on every host, so a word converts to and from the host byte
+// order when it is read or assigned. Strings, pixels and other raw buffers are
+// copied byte for byte; the _LEndian functions convert arrays of words.
+struct CKChunkWord
+{
+    int Raw;
+
+    operator int() const { return Swap(Raw); }
+    CKChunkWord &operator=(int value)
+    {
+        Raw = Swap(value);
+        return *this;
+    }
+
+    static int Swap(int value)
+    {
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+        return (int)__builtin_bswap32((unsigned int)value);
+#else
+        return value;
+#endif
+    }
+};
+
 struct ChunkIteratorData
 {
