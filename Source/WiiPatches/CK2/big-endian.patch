+
+static void SwapHeaderPart1(CKFileHeaderPart1 &part) {
+    CKConvertEndianArray32(&part, sizeof(part) / sizeof(CKDWORD));
+}
+
+static void SwapGuids(CKGUID *guids, int count) {
+    CKConvertEndianArray32(guids, count * 2);
+}
+
+static void WriteFileInt(CKBufferParser *parser, int value) {
+    value = CKChunkWord::Swap(value);
+    parser->Write(&value, sizeof(value));
+}
+
+static void WriteFileGuid(CKBufferParser *parser, const CKGUID &guid) {
+    WriteFileInt(parser, guid.d1);
+    WriteFileInt(parser, guid.d2);
+}
