@@ -13,6 +13,86 @@
 XObjectPointerArray CKStateChunk::m_TempXOPA;
 XObjectArray CKStateChunk::m_TempXOA;
 
+// Chunk data keeps the little-endian file layout on every host (see
+// CKChunkWord). The helpers below convert between that layout and the host
+// byte order; on little-endian hosts they do nothing.
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+#define CK_CHUNK_BIG_ENDIAN 1
+#else
+#define CK_CHUNK_BIG_ENDIAN 0
+#endif
+
+// Swaps each whole 32-bit word of a buffer of byteCount bytes.
+static void SwapChunkWords32(void *data, int byteCount) {
+    if (CK_CHUNK_BIG_ENDIAN && data && byteCount >= 4)
+        CKConvertEndianArray32(data, byteCount / 4);
+}
+
+// Swaps each whole 16-bit word of a buffer of byteCount bytes.
+static void SwapChunkWords16(void *data, int byteCount) {
+    if (CK_CHUNK_BIG_ENDIAN && data && byteCount >= 2)
+        CKConvertEndianArray16(data, byteCount / 2);
+}
+
+// Words of a file buffer, which need not be aligned.
+static int LoadFileInt(const void *buffer, int index) {
+    CKChunkWord word;
+    memcpy(&word, static_cast<const char *>(buffer) + index * sizeof(int), sizeof(word));
+    return word;
+}
+
+static void StoreFileInt(void *buffer, int index, int value) {
+    CKChunkWord word;
+    word = value;
+    memcpy(static_cast<char *>(buffer) + index * sizeof(int), &word, sizeof(word));
+}
+
+// Copies count host ints into a file buffer, or file words into host ints.
+static void StoreFileInts(void *buffer, int index, const int *values, int count) {
+    memcpy(static_cast<char *>(buffer) + index * sizeof(int), values, count * sizeof(int));
+    SwapChunkWords32(static_cast<char *>(buffer) + index * sizeof(int), count * (int) sizeof(int));
+}
+
+static void LoadFileInts(int *values, const void *buffer, int index, int count) {
+    memcpy(values, static_cast<const char *>(buffer) + index * sizeof(int), count * sizeof(int));
+    SwapChunkWords32(values, count * (int) sizeof(int));
+}
+
+// Lists of a top-level chunk (Flag set) are host ints; the lists of a
+// sub-chunk live inside the parent's data and keep the file layout.
+static int IteratorListEntry(const ChunkIteratorData *it, const int *list, int index) {
+    return it->Flag ? list[index] : CKChunkWord::Swap(list[index]);
+}
+
+// 32-bit pixels are host-order ARGB words: byte offset of each channel.
+static const int kPixelBlueByte = CK_CHUNK_BIG_ENDIAN ? 3 : 0;
+static const int kPixelGreenByte = CK_CHUNK_BIG_ENDIAN ? 2 : 1;
+static const int kPixelRedByte = CK_CHUNK_BIG_ENDIAN ? 1 : 2;
+static const int kPixelAlphaByte = CK_CHUNK_BIG_ENDIAN ? 0 : 3;
+
+// Reads a 1 to 4 byte pixel the way VxMath stores it: 16 and 32-bit pixels are
+// host-order words, 24-bit pixels are blue, green, red bytes.
+static CKDWORD ReadPackedPixel(const CKBYTE *pixel, int bytesPerPixel) {
+    switch (bytesPerPixel) {
+    case 1:
+        return pixel[0];
+    case 2: {
+        CKWORD value;
+        memcpy(&value, pixel, sizeof(value));
+        return value;
+    }
+    case 3:
+        return pixel[0] | (pixel[1] << 8) | (pixel[2] << 16);
+    case 4: {
+        CKDWORD value;
+        memcpy(&value, pixel, sizeof(value));
+        return value;
+    }
+    default:
+        return 0;
+    }
+}
