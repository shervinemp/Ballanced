+#if defined(GEKKO)
+// Compositions store a system font as its index in the font list of the PC
+// they were made on. The Wii only has the fonts in the game's Fonts folder, so
+// an index past its list takes Arial, else Roboto (installed with the game),
+// else the first font.
+static int WiiFallbackFontIndex(const CKEnumStruct *data, int sysFontIndex)
+{
+	if (!data || data->NbData <= 0 || (sysFontIndex >= 0 && sysFontIndex < data->NbData))
+		return sysFontIndex;
+	static const char *const kFallbacks[] = {"Arial", "Roboto"};
+	for (int f = 0; f < 2; ++f)
+	{
+		for (int i = 0; i < data->NbData; ++i)
+		{
+			if (data->Desc[i] && !strcmp(data->Desc[i], kFallbacks[f]))
+				return i;
+		}
+	}
+	return 0;
+}
+#endif
