+// The script builds the path to look for from the game folder and a
+// Windows-style relative path ("\Sounds\"), while the player may have
+// registered it with other separators, case or "." segments.
+static XString ComparablePath(const char *path)
+{
+    XString result;
+    for (const char *p = path; p && *p; ++p)
+    {
+        const char c = (*p == '\\') ? '/' : (char)tolower((unsigned char)*p);
+        const bool segmentStart = p == path || p[-1] == '/' || p[-1] == '\\';
+        if (c == '.' && segmentStart && (p[1] == '/' || p[1] == '\\' || p[1] == '\0'))
+            continue;
+        if (c == '/' && result.Length() != 0 && result[result.Length() - 1] == '/')
+            continue;
+        result << c;
+    }
+    while (result.Length() > 1 && result[result.Length() - 1] == '/')
+        result.Crop(0, result.Length() - 1);
+    return result;
+}
