+struct CollisionSurfaceBuild
+{
+    CKContext *Context;
+    CK3dEntity *Target;
+};
+
+// Builds a named collision surface the shape cache does not have.
+static IVP_Compact_Surface *BuildCollisionSurface(const wiiphysicsshapes::Source &source, void *user)
+{
+    const CollisionSurfaceBuild *build = (const CollisionSurfaceBuild *)user;
+    VxVector scale = source.Scale;
+    IVP_SurfaceBuilder_Ledge_Soup builder;
+    int ledgeCount = 0;
+
+    if (source.ConvexCount > 0)
+    {
+        for (int i = 0; i < source.ConvexCount; i++)
+        {
+            if (source.Convexes[i])
+            {
+                ledgeCount += CKIpionManager::AddConvexSurface(&builder, source.Convexes[i], &scale);
+            }
+        }
+    }
+
+    if (source.ConcaveCount > 0)
+    {
+        for (int i = 0; i < source.ConcaveCount; i++)
+        {
+            if (source.Concaves[i])
+            {
+                CKIpionManager::AddConcaveSurface(&builder, source.Concaves[i], &scale);
+                ++ledgeCount;
+            }
+        }
+    }
+
+    if (ledgeCount == 0)
+    {
+        build->Context->OutputToConsoleEx("Error: incorrect mesh for %s !\n", build->Target->GetName());
+        return NULL;
+    }
+    return builder.compile();
+}
