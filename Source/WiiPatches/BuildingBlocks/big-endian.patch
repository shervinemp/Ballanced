+// Database files store ints and floats in little-endian order on every host,
+// at offsets that need not be aligned.
+static void SwapLittleEndian32(void *value)
+{
+    CKConvertEndianArray32(value, 1);
+}
+
+static void StoreInt32At(char *buffer, int offset, int value)
+{
+    SwapLittleEndian32(&value);
+    memcpy(buffer + offset, &value, sizeof(int));
+}
+
+static void StoreFloatAt(char *buffer, int offset, float value)
+{
+    SwapLittleEndian32(&value);
+    memcpy(buffer + offset, &value, sizeof(float));
+}
+
 static bool ReadInt32At(const char *buffer, int bufferSize, int offset, int *outValue)
 {
     if (!buffer || !outValue || offset < 0 || offset > bufferSize - (int)sizeof(int))
         return false;
 
     memcpy(outValue, buffer + offset, sizeof(int));
+    SwapLittleEndian32(outValue);
     return true;
 }
 
