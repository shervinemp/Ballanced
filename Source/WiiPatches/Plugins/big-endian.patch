     // Shared helper to fill a VxImageDescEx for BGRA32 format
     static void FillFormatBGRA32(VxImageDescEx &fmt, int width, int height, int bytesPerLine, CKBYTE *image)
     {
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+        // Readers decode blue, green, red, alpha bytes, while 32-bit pixels
+        // are host-order ARGB words: reverse each pixel on big-endian hosts.
+        for (int y = 0; image && y < height; ++y)
+        {
+            CKBYTE *row = image + y * bytesPerLine;
+            for (int x = 0; x < width; ++x)
+            {
+                CKDWORD pixel;
+                memcpy(&pixel, row + x * 4, sizeof(pixel));
+                pixel = __builtin_bswap32(pixel);
+                memcpy(row + x * 4, &pixel, sizeof(pixel));
+            }
+        }
+#endif
         memset(&fmt, 0, sizeof(VxImageDescEx));
         fmt.Size = sizeof(VxImageDescEx);
         fmt.Flags = 0;
@@ -182,13 +197,36 @@ public:
         fmt.Image = image;
     }
 
-    // Pixels to save. CK2 save paths built from GetImageDesc() leave
-    // m_Format.Image null and pass the surface through m_Data instead.
-    static CKBYTE *GetSavePixels(CKBitmapProperties *bp)
+    // Pixels to save, as blue, green, red, alpha bytes. CK2 save paths built
+    // from GetImageDesc() leave m_Format.Image null and pass the surface
+    // through m_Data instead. 32-bit pixels are host-order ARGB words, so on
+    // big-endian hosts this returns a byte-reversed copy held in scratch.
+    static CKBYTE *GetSavePixels(CKBitmapProperties *bp, XArray<CKBYTE> &scratch)
     {
-        if (bp->m_Format.Image)
-            return bp->m_Format.Image;
-        return static_cast<CKBYTE *>(bp->m_Data);
+        CKBYTE *pixels = bp->m_Format.Image ? bp->m_Format.Image : static_cast<CKBYTE *>(bp->m_Data);
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+        const VxImageDescEx &fmt = bp->m_Format;
+        if (pixels && fmt.Width > 0 && fmt.Height > 0 && fmt.BytesPerLine >= fmt.Width * 4)
+        {
+            scratch.Resize(fmt.BytesPerLine * fmt.Height);
+            for (int y = 0; y < fmt.Height; ++y)
+            {
+                const CKBYTE *src = pixels + y * fmt.BytesPerLine;
+                CKBYTE *dst = scratch.Begin() + y * fmt.BytesPerLine;
+                for (int x = 0; x < fmt.Width * 4; x += 4)
+                {
+                    dst[x + 0] = src[x + 3];
+                    dst[x + 1] = src[x + 2];
+                    dst[x + 2] = src[x + 1];
+                    dst[x + 3] = src[x + 0];
+                }
+            }
+            return scratch.Begin();
+        }
+#else
+        (void)scratch;
+#endif
+        return pixels;
     }
 
