+// The 16-bit header fields are little-endian.
+static CKWORD ReadHeaderWord(const CKWORD &field)
+{
+    const CKBYTE *bytes = (const CKBYTE *)&field;
+    return (CKWORD)(bytes[0] | (bytes[1] << 8));
+}
+
 static int ParsePcxHeader(PcxDataSource &src, PcxContext &ctx)
 {
     if (!src.ReadHeader(ctx.header))
         return CKBITMAPERROR_READERROR;
+    ctx.header.xMin = ReadHeaderWord(ctx.header.xMin);
+    ctx.header.yMin = ReadHeaderWord(ctx.header.yMin);
+    ctx.header.xMax = ReadHeaderWord(ctx.header.xMax);
+    ctx.header.yMax = ReadHeaderWord(ctx.header.yMax);
+    ctx.header.hDPI = ReadHeaderWord(ctx.header.hDPI);
+    ctx.header.vDPI = ReadHeaderWord(ctx.header.vDPI);
+    ctx.header.bytesPerLine = ReadHeaderWord(ctx.header.bytesPerLine);
+    ctx.header.paletteInfo = ReadHeaderWord(ctx.header.paletteInfo);
+    ctx.header.hScreenSize = ReadHeaderWord(ctx.header.hScreenSize);
+    ctx.header.vScreenSize = ReadHeaderWord(ctx.header.vScreenSize);
 
     if (ctx.header.manufacturer != 0x0A)
         return CKBITMAPERROR_UNSUPPORTEDFILE;
