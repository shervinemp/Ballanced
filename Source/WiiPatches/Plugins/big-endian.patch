diff --git a/ImageReader/ImageReader.h b/ImageReader/ImageReader.h
index e54573e..fe59ba2 100644
--- a/ImageReader/ImageReader.h
+++ b/ImageReader/ImageReader.h
@@ -165,6 +165,21 @@ public:
     // Shared helper to fill a VxImageDescEx for BGRA32 format
     static void FillFormatBGRA32(VxImageDescEx &fmt, int width, int height, int bytesPerLine, CKBYTE *image)
     {
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+        // Readers decode blue, green, red, alpha bytes, while 32-bit pixels
+        // are host-order ARGB words: reverse each pixel on big-endian hosts.
+        for (int y = 0; image && y < height; ++y)
+        {
+            CKBYTE *row = image + y * bytesPerLine;
+            for (int x = 0; x < width; ++x)
+            {
+                CKDWORD pixel;
+                memcpy(&pixel, row + x * 4, sizeof(pixel));
+                pixel = __builtin_bswap32(pixel);
+                memcpy(row + x * 4, &pixel, sizeof(pixel));
+            }
+        }
+#endif
         memset(&fmt, 0, sizeof(VxImageDescEx));
         fmt.Size = sizeof(VxImageDescEx);
         fmt.Flags = 0;
